menu "MushFarm"

config MF_SENSORS_MOCK
    bool "Use mock sensor values (CI / bench without I2C)"
    default y
    help
        When enabled, SCD41 path returns synthetic RH/CO2/T.
        Disable on real hardware to use I2C drivers.

config MF_WIFI_SOFTAP
    bool "Enable Wi-Fi SoftAP + captive-friendly stack (Sprint 6)"
    default y

config MF_HTTP_API
    bool "Enable HTTP /api/v1 subset (Sprint 6)"
    default y
    depends on MF_WIFI_SOFTAP

config MF_MQTT_ENABLE
    bool "Enable MQTT client task (Sprint 7)"
    default n

config MF_SD_LOG_ENABLE
    bool "Enable SD card FAT mount for logs (Sprint 8)"
    default n

config MF_AUTO_DEMO_CYCLE
    bool "Auto-select embedded demo recipe and start cycle (lab only)"
    default y

config MF_MQTT_BROKER_URI
    string "MQTT broker URI (Sprint 7)"
    default "mqtt://192.168.1.10"
    depends on MF_MQTT_ENABLE

endmenu
